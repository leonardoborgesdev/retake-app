    "This job never finished. The app was likely closed or ran out of time in the background, so nothing was saved to Photos." : { "localizations" : { "pt" : { "stringUnit" : { "state" : "translated", "value" : "Esse processo nunca terminou. O app provavelmente foi fechado ou ficou sem tempo em segundo plano, então nada foi salvo nas Fotos." } } } },
