{
  "$schema": "https://opencode.ai/config.json",
  "model": "tokenrouter/moonshotai/kimi-k3-free",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k3-free": {
          "name": "Kimi K3 Free",
          "limit": {
            "context": 1048576,
            "output": 2048
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 Pay As You Go",
          "limit": {
            "context": 1048576,
            "output": 4096
          }
        }
      }
    }
  }
}
