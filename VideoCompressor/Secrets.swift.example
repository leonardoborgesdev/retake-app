import Foundation

/// Copy this file to `Secrets.swift` (same directory) and fill in your own Supabase
/// project details. `Secrets.swift` is gitignored and never committed — see
/// `SupabaseAuthClient.swift` for where these values are consumed.
///
/// Auth is optional: the compression and cut/retake features work fully offline
/// without any of this configured. This only backs the (currently local-only)
/// account screen.
enum Secrets {
    static let supabaseURL = URL(string: "https://your-project.supabase.co")!
    static let supabaseAnonKey = "your-anon-key"
}
