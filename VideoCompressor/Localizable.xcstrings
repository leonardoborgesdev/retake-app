    "Amber segments are dead air: the same audio that would sit untouched in a plain edit." : { "localizations" : { "pt" : { "stringUnit" : { "state" : "translated", "value" : "Os trechos em âmbar são silêncio: o mesmo áudio que ficaria intacto numa edição simples." } } } },
    "Large or iCloud videos can take a moment to download. No size limit, just hang tight." : { "localizations" : { "pt" : { "stringUnit" : { "state" : "translated", "value" : "Vídeos grandes ou do iCloud podem levar um tempo pra baixar. Sem limite de tamanho, só aguarde." } } } },
